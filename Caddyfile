# Caddy: терминация TLS (авто Let's Encrypt) + обратный прокси.
# Домен и e-mail для ACME подставляются из переменных окружения
# (DOMAIN, ACME_EMAIL) — см. docker-compose.prod.yml.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Бэкенд Django: API, админка и его статика (whitenoise).
	@backend {
		path /api/* /admin/* /static/* /django-static/*
	}
	handle @backend {
		reverse_proxy backend:8000
	}

	# Всё остальное — Next.js фронтенд.
	handle {
		reverse_proxy frontend:3000
	}
}

# ── Production environment template ──────────────────────────────────────
# Скопируй в .env.prod на сервере и заполни реальными значениями.
# .env.prod в git НЕ коммитится.

# Домен (без протокола) и e-mail для Let's Encrypt (ACME).
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# ── Django ───────────────────────────────────────────────────────────────
DJANGO_DEBUG=0
# Сгенерировать новый: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_NEW
# ВАЖНО: тот же ключ, которым зашифрованы TOTP-секреты в переносимом дампе.
TOTP_ENCRYPTION_KEY=SAME_AS_SOURCE_ENVIRONMENT
SQL_DEBUG=0
DJANGO_LOG_LEVEL=INFO

# Хосты и доверенные источники (через запятую). Подставь свой домен.
# backend — внутреннее docker-имя сервиса; localhost — нужен для healthcheck
DJANGO_ALLOWED_HOSTS=example.com,backend,localhost
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# ── Postgres (используется backend и контейнером postgres) ───────────────
POSTGRES_DB=web_game
POSTGRES_USER=web_game
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Frontend (вшивается в бандл на этапе сборки) ─────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://example.com/api

# ── S3 (медиа моделей) ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=***
AWS_SECRET_ACCESS_KEY=***
AWS_STORAGE_BUCKET_NAME=***
AWS_S3_REGION_NAME=***
AWS_S3_ENDPOINT_URL=
AWS_DEFAULT_ACL=
AWS_S3_ADDRESSING_STYLE=
AWS_S3_SIGNATURE_VERSION=

# ── Прочее ───────────────────────────────────────────────────────────────
# POLZA_AI_API_KEY=***
# MINIGAME_BOARD_SALT=

# Multi-stage production build for Next.js (standalone output).
FROM node:22-alpine AS builder

WORKDIR /app

# Детерминированная установка по lock-файлу.
COPY package.json package-lock.json* ./
RUN npm ci --network-timeout=300000

COPY . .

# NEXT_PUBLIC_* инлайнятся в клиентский бандл на этапе сборки, поэтому
# публичный URL API должен быть известен здесь (через build-arg).
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}

ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# --- Runtime stage: минимальный образ только со standalone-сборкой ---
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Непривилегированный пользователь.
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

# standalone содержит server.js и минимальный набор node_modules.
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
